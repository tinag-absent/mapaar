# Nginx Configuration Example for 404 Error Page
# 
# この設定をnginxの設定ファイル（通常は /etc/nginx/sites-available/your-site）に追加してください

server {
    listen 80;
    server_name your-domain.com;
    root /var/www/html/Area-rjgarj-main;
    index index.html;

    # 404 Error Page
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Main location block
    location / {
        try_files $uri $uri/ =404;
    }

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;

    # Browser Caching
    location ~* \.(jpg|jpeg|png|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(css|js)$ {
        expires 1M;
        add_header Cache-Control "public";
    }

    location ~* \.(json)$ {
        expires 1w;
        add_header Cache-Control "public";
    }
}

# 設定を反映させる手順:
# 1. この設定を /etc/nginx/sites-available/your-site に保存
# 2. シンボリックリンクを作成: sudo ln -s /etc/nginx/sites-available/your-site /etc/nginx/sites-enabled/
# 3. 設定をテスト: sudo nginx -t
# 4. Nginxを再起動: sudo systemctl restart nginx
